# Copy to .env, then run ./setup.sh - it generates the secrets.
#   cp .env.example .env

# ------------------------------------------------------------- Chat (port 3000)
WEBUI_SECRET_KEY=CHANGE_ME_SECRET
WEBUI_PORT=3000
WEBUI_NAME=Local AI

# Set to False after registering the first account (which becomes admin)
ENABLE_SIGNUP=True

# --------------------------------------------------------- File access in chat
# Folder the browser chat is allowed to read. Mounted read-only and reachable
# as /workspace from the chat. Adjust it to your machine - usually the folder
# that holds all your projects. Absolute path or ${HOME}/..., not ~.
# Windows: C:/Users/<you>/projects, with forward slashes.
# Only for the browser chat; the editors read the project they have open.
# After changing it: docker compose up -d
WORKSPACE_DIR=${HOME}/projects

# ------------------------------------------------------- Skills in the browser chat
# Folder ./load-skills-openwebui.sh imports skills from - one subfolder with a SKILL.md
# per skill. Absolute path or ${HOME}/..., not ~. Windows: C:/Users/<you>/.agents/skills
SKILLS_DIR=${HOME}/.agents/skills
